# Local API runtime
KAITIAKI_API_HOST=0.0.0.0
KAITIAKI_API_PORT=8093

# Local MCP runtime
KAITIAKI_MCP_HOST=0.0.0.0
KAITIAKI_MCP_PORT=8172
KAITIAKI_MCP_TRANSPORT=streamable-http
KAITIAKI_MCP_PATH=/mcp

# Local inference upstream
KAITIAKI_INFERENCE_ENDPOINT=http://127.0.0.1:8090

# Local semantic index profile
KAITIAKI_EMBED_MODE=light-v2-fallback
KAITIAKI_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
KAITIAKI_EMBED_DIM=64
