# Local llama.cpp profile example for devcontainer-local

LLAMA_SERVER_BIN=$HOME/llama.cpp/build/bin/llama-server
LLAMA_MODEL_PATH=$HOME/models/Qwen3.5-9B-Uncensored-Q8_0.gguf

# Profile port alignment
LLAMA_API_HOST=0.0.0.0
LLAMA_API_PORT=8090

# GPU / CUDA offload
LLAMA_ARG_N_GPU_LAYERS=99
LLAMA_ARG_MAIN_GPU=0

# Runtime tuning carried forward from the earlier local profile
LLAMA_ARG_CTX_SIZE=8192
LLAMA_ARG_BATCH=512
LLAMA_ARG_THREADS=8
LLAMA_ARG_CACHE_TYPE_K=f16
LLAMA_ARG_CACHE_TYPE_V=f16

# Optional generation defaults
LLAMA_ARG_TEMP=0.8
LLAMA_ARG_TOP_P=0.95
