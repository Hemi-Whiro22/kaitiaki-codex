# Profile environment example

# Set the active profile name for local tooling.
KAITIAKI_PROFILE=devcontainer-local

# Local service placeholders.
API_PORT=8093
MODEL_PORT=8090
MCP_PORT=8172

# Local llama.cpp profile placeholders.
LLAMA_SERVER_BIN=$HOME/llama.cpp/build/bin/llama-server
LLAMA_MODEL_PATH=$HOME/models/Qwen3.5-9B-Uncensored-Q8_0.gguf
LLAMA_API_HOST=0.0.0.0
LLAMA_API_PORT=8090
LLAMA_ARG_N_GPU_LAYERS=99
LLAMA_ARG_MAIN_GPU=0
LLAMA_ARG_CTX_SIZE=8192
LLAMA_ARG_BATCH=512
LLAMA_ARG_THREADS=8
LLAMA_ARG_CACHE_TYPE_K=f16
LLAMA_ARG_CACHE_TYPE_V=f16
LLAMA_ARG_TEMP=0.8
LLAMA_ARG_TOP_P=0.95

# Optional future settings.
PYTHON_VERSION=3.11
NODE_VERSION=20
